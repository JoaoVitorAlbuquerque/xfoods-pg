generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  STAFF

  @@map("user_role")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(OWNER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  leads              Lead[]
  categories         Category[]
  ingredients        Ingredient[]
  products           Product[]
  orders             Order[]
  productIngredients ProductIngredient[]
  productOrders      ProductOrder[]
  measurementUnits   MeasurementUnit[]
  supplyCategories   SupplyCategory[]
  supplies           Supply[]
  stockMovements     StockMovement[]
  stockCounts        StockCount[]
  stockSettings      StockSettings?
  suppliers          Supplier[]
  purchases          Purchase[]
  supplyCostHistory  SupplyCostHistory[]
  recipes            Recipe[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  costAllocation     CostAllocationSettings?
  pricingSettings    PricingSettings?

  @@map("users")
}

enum UnitKind {
  WEIGHT
  VOLUME
  COUNT

  @@map("unit_kind")
}

/// Unidade de medida usada em compra, estoque e consumo.
///
/// Cada grandeza tem uma base canônica em que todo cálculo interno acontece:
/// G para massa, ML para volume, UN para contagem. `factorToBase` diz quantas
/// unidades base cabem em 1 desta unidade — 1 KG = 1000 G, 1 L = 1000 ML.
///
/// Contagem nunca converte para massa ou volume: 1 KG não é 1 UN. É o `kind`
/// que garante isso, e a conversão entre grandezas diferentes é recusada.
model MeasurementUnit {
  id String @id @default(uuid()) @db.Uuid

  /// Nulo nas unidades de sistema, que são compartilhadas por todos os
  /// estabelecimentos. KG, G, L e ML são constantes físicas: duplicá-las por
  /// tenant abriria espaço para alguém salvar "1 KG = 500 G" e corromper o
  /// custo de todas as fichas técnicas em silêncio.
  userId String? @map("user_id") @db.Uuid

  code String
  name String
  kind UnitKind

  /// Nulo em unidades de embalagem (CX, PCT, FARDO): não existe fator
  /// universal, porque uma caixa de tomate não pesa o mesmo que uma de azeite.
  /// Esse fator passa a ser definido por insumo no módulo de compras.
  factorToBase Decimal? @map("factor_to_base") @db.Decimal(20, 8)

  /// Marca a unidade canônica da grandeza (G, ML, UN).
  isBase      Boolean @default(false) @map("is_base")
  isPackaging Boolean @default(false) @map("is_packaging")
  isSystem    Boolean @default(false) @map("is_system")
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  suppliesAsBaseUnit     Supply[]
  stockMovements         StockMovement[]
  stockCountItems        StockCountItem[]
  purchaseItems          PurchaseItem[]
  costHistoryEntries     SupplyCostHistory[]
  suppliesAsLastPurchase Supply[]            @relation("SupplyLastPurchaseUnit")
  recipeYields           Recipe[]            @relation("RecipeYieldUnit")
  recipeItems            RecipeItem[]        @relation("RecipeItemUnit")

  @@unique([userId, code])
  @@index([userId])
  @@index([kind])
  @@map("measurement_units")
}

model Lead {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  email     String?  @unique
  phone     String   @unique
  address   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("leads")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  icon      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([userId])
  @@map("categories")
}

// Etiqueta de exibição do cardápio (nome + ícone) — NÃO é insumo de estoque.
// O insumo com unidade, saldo e custo entra na Fase 2 como o modelo `Supply`.
model Ingredient {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  icon      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  products ProductIngredient[]

  @@index([userId])
  @@map("ingredients")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  categoryId  String?  @map("category_id") @db.Uuid
  name        String
  description String
  imagePath   String   @map("image_path")
  price       Decimal  @db.Decimal(12, 2)
  deleted     Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ingredients ProductIngredient[]
  orders      ProductOrder[]
  recipes     Recipe[]

  @@index([userId, deleted])
  @@index([categoryId])
  @@map("products")
}

enum OrderType {
  WAITING
  IN_PRODUCTION
  DONE
  CANCELED

  @@map("order_type")
}

model Order {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  leadId      String?   @map("lead_id") @db.Uuid
  table       Int
  status      OrderType @default(WAITING)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  description String?
  read        Boolean   @default(false)
  restarted   Boolean   @default(false)
  paid        Boolean   @default(false)

  // Total congelado no momento da venda, somando os itens.
  totalAmount Decimal @default(0) @map("total_amount") @db.Decimal(12, 2)

  // Evento de venda datado — é o que delimita período em relatórios de margem.
  paidAt     DateTime? @map("paid_at")
  canceledAt DateTime? @map("canceled_at")
  deletedAt  DateTime? @map("deleted_at")

  // Trava de idempotência da baixa de estoque (Fase 5). A baixa só executa
  // enquanto este campo for nulo; o estorno grava movimentos inversos e o zera.
  stockAppliedAt DateTime? @map("stock_applied_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead     Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  products ProductOrder[]

  @@index([userId, createdAt])
  @@index([userId, restarted])
  @@index([userId, paidAt])
  @@index([leadId])
  @@map("orders")
}

// Vínculo produto <-> etiqueta de cardápio. Sem quantidade e sem unidade
// de propósito: a ficha técnica é o modelo `Recipe` da Fase 4.
model ProductIngredient {
  productId    String  @map("product_id") @db.Uuid
  ingredientId String  @map("ingredient_id") @db.Uuid
  userId       String? @map("user_id") @db.Uuid

  product    Product    @relation(fields: [productId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
  @@map("product_ingredient")
}

enum SizeType {
  TINY
  SMALL
  MEAN
  LARGE
  EXTRA_LARGE
  METER

  @@map("size_type")
}

model ProductOrder {
  // Id próprio: sem ele não há como amarrar um movimento de estoque
  // a um item de venda específico, nem estornar item a item (Fase 5).
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  orderId   String @map("order_id") @db.Uuid

  size     SizeType @default(MEAN)
  quantity Int      @default(1)

  // Preço congelado na venda. Sem isto, alterar o preço de um prato
  // reescreveria o faturamento de todos os meses anteriores.
  unitPrice  Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal @map("total_price") @db.Decimal(12, 2)

  /// Snapshot da ficha técnica usada nesta venda. Preenchido pela baixa
  /// automática (Fase 5) e nulo até lá.
  ///
  /// Guardar a versão e o custo congelados é o que torna a margem histórica
  /// verdadeira: editar a ficha ou o preço de um insumo depois não pode mudar
  /// o que aquele prato custou no dia em que foi vendido — foi o mesmo motivo
  /// de `unitPrice` existir aqui.
  recipeId        String?  @map("recipe_id") @db.Uuid
  recipeUnitCost  Decimal? @map("recipe_unit_cost") @db.Decimal(14, 6)
  recipeTotalCost Decimal? @map("recipe_total_cost") @db.Decimal(14, 4)

  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipe  Recipe? @relation(fields: [recipeId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("product_order")
}

// ===========================================================================
// Insumos e estoque
// ===========================================================================

model SupplyCategory {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  name   String
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplies Supply[]

  @@unique([userId, name])
  @@index([userId])
  @@map("supply_categories")
}

/// Insumo: tudo que é consumido para produzir — carne, queijo, tempero,
/// espeto de madeira, embalagem.
///
/// `currentStock` é cache denormalizado: o saldo verdadeiro é a soma de
/// `quantityBase` em `StockMovement`. Os dois só são escritos juntos, na mesma
/// transação, e o teste de reconciliação confere que não divergiram.
model Supply {
  id               String  @id @default(uuid()) @db.Uuid
  userId           String  @map("user_id") @db.Uuid
  supplyCategoryId String? @map("supply_category_id") @db.Uuid

  /// Unidade em que o saldo deste insumo é guardado. Toda quantidade informada
  /// em outra unidade é convertida para cá antes de virar movimentação.
  /// Não pode ser unidade de embalagem: sem fator, não há como converter.
  baseUnitId String @map("base_unit_id") @db.Uuid

  name        String
  description String?

  currentStock Decimal  @default(0) @map("current_stock") @db.Decimal(18, 6)
  minStock     Decimal  @default(0) @map("min_stock") @db.Decimal(18, 6)
  maxStock     Decimal? @map("max_stock") @db.Decimal(18, 6)

  /// Custo médio ponderado por unidade base, recalculado a cada entrada com
  /// custo informado. É o que valoriza as saídas. O histórico de custo e a
  /// entrada por nota de compra entram no módulo de compras.
  averageCost Decimal  @default(0) @map("average_cost") @db.Decimal(14, 6)
  lastCost    Decimal? @map("last_cost") @db.Decimal(14, 6)

  /// Qual custo vale como "custo atual" deste insumo. Só LAST_PURCHASE está
  /// implementado; os demais existem para que trocar de método seja mudar um
  /// campo, não reescrever quem valoriza saída. `averageCost` continua sendo
  /// mantido a cada entrada, então AVERAGE já nasce com dado para usar.
  costingMethod CostingMethod @default(LAST_PURCHASE) @map("costing_method")

  /// Dados da última aquisição, para o relatório de variação de preço.
  lastPurchaseAt        DateTime? @map("last_purchase_at")
  lastSupplierId        String?   @map("last_supplier_id") @db.Uuid
  lastPurchaseUnitPrice Decimal?  @map("last_purchase_unit_price") @db.Decimal(14, 6)
  lastPurchaseUnitId    String?   @map("last_purchase_unit_id") @db.Uuid

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    SupplyCategory?  @relation(fields: [supplyCategoryId], references: [id], onDelete: SetNull)
  baseUnit    MeasurementUnit  @relation(fields: [baseUnitId], references: [id])
  movements   StockMovement[]
  countItems  StockCountItem[]
  recipeItems RecipeItem[]

  lastSupplier     Supplier?           @relation("SupplyLastSupplier", fields: [lastSupplierId], references: [id], onDelete: SetNull)
  lastPurchaseUnit MeasurementUnit?    @relation("SupplyLastPurchaseUnit", fields: [lastPurchaseUnitId], references: [id])
  purchaseItems    PurchaseItem[]
  costHistory      SupplyCostHistory[]

  @@unique([userId, name])
  @@index([userId, active])
  @@index([supplyCategoryId])
  @@map("supplies")
}

enum CostingMethod {
  /// Custo atual = último preço pago. Único implementado nesta versão.
  LAST_PURCHASE
  AVERAGE
  FIFO
  BY_BATCH

  @@map("costing_method")
}

enum StockMovementType {
  PURCHASE
  SALE
  LOSS
  ADJUSTMENT
  PRODUCTION
  RETURN
  TRANSFER

  @@map("stock_movement_type")
}

/// Livro-razão do estoque. Append-only: nada aqui é atualizado nem apagado, e
/// estorno vira movimento compensatório. É o que torna auditável a pergunta
/// "por que o saldo é esse".
///
/// CONVENÇÃO DE SINAL: negativo é saída. Vale para `quantity`, `quantityBase`
/// e `totalCost` ao mesmo tempo — um único campo carregando o sentido evita
/// que duas fontes de verdade divirjam. Saldo = SUM(quantity_base).
model StockMovement {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  supplyId String @map("supply_id") @db.Uuid

  /// Unidade em que a quantidade foi informada, preservada para auditoria:
  /// "entrei 10 KG" continua legível mesmo com o saldo guardado em gramas.
  unitId String @map("unit_id") @db.Uuid

  type StockMovementType

  quantity     Decimal @db.Decimal(18, 6)
  quantityBase Decimal @map("quantity_base") @db.Decimal(18, 6)

  /// Custo por unidade base, sempre positivo. `totalCost` acompanha o sinal da
  /// quantidade, então SUM(total_cost) é o valor do estoque.
  unitCost  Decimal @default(0) @map("unit_cost") @db.Decimal(14, 6)
  totalCost Decimal @default(0) @map("total_cost") @db.Decimal(14, 4)

  /// Saldo do insumo depois deste movimento, para reconstruir o extrato sem
  /// somar a tabela inteira a cada linha.
  balanceAfter Decimal @map("balance_after") @db.Decimal(18, 6)

  /// Origem do movimento: STOCK_COUNT, ORDER, PURCHASE... com o id do documento.
  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id") @db.Uuid

  reason String?

  /// Movimento que este estorna. `@unique` garante que um movimento só possa
  /// ser estornado uma vez — sem isso, dois cancelamentos concorrentes
  /// devolveriam o mesmo consumo duas vezes ao estoque.
  reversalOfId String? @unique @map("reversal_of_id") @db.Uuid

  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  supply Supply          @relation(fields: [supplyId], references: [id])
  unit   MeasurementUnit @relation(fields: [unitId], references: [id])

  reversalOf StockMovement? @relation("MovementReversal", fields: [reversalOfId], references: [id])
  reversedBy StockMovement? @relation("MovementReversal")

  countItem    StockCountItem?
  PurchaseItem PurchaseItem?

  @@index([userId, supplyId, occurredAt])
  @@index([userId, type])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

enum StockCountStatus {
  OPEN
  APPLIED
  CANCELED

  @@map("stock_count_status")
}

/// Contagem física. Enquanto está OPEN nada afeta o estoque; ao aplicar, cada
/// item com diferença gera um movimento de ADJUSTMENT.
model StockCount {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  status StockCountStatus @default(OPEN)
  note   String?

  countedAt  DateTime  @default(now()) @map("counted_at")
  appliedAt  DateTime? @map("applied_at")
  canceledAt DateTime? @map("canceled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items StockCountItem[]

  @@index([userId, status])
  @@map("stock_counts")
}

model StockCountItem {
  id           String @id @default(uuid()) @db.Uuid
  stockCountId String @map("stock_count_id") @db.Uuid
  supplyId     String @map("supply_id") @db.Uuid
  unitId       String @map("unit_id") @db.Uuid

  countedQuantity     Decimal @map("counted_quantity") @db.Decimal(18, 6)
  countedQuantityBase Decimal @map("counted_quantity_base") @db.Decimal(18, 6)

  /// Preenchidos no momento da aplicação, não na digitação: o saldo do sistema
  /// pode mudar entre contar e aplicar, e o que vale é o do instante do ajuste.
  systemQuantityBase Decimal? @map("system_quantity_base") @db.Decimal(18, 6)
  differenceBase     Decimal? @map("difference_base") @db.Decimal(18, 6)

  movementId String? @unique @map("movement_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  stockCount StockCount      @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  supply     Supply          @relation(fields: [supplyId], references: [id])
  unit       MeasurementUnit @relation(fields: [unitId], references: [id])
  movement   StockMovement?  @relation(fields: [movementId], references: [id])

  @@unique([stockCountId, supplyId])
  @@index([supplyId])
  @@map("stock_count_items")
}

/// Configuração de estoque do estabelecimento. Tabela própria porque vai
/// crescer (método de custeio, política de alerta) e porque um registro
/// ausente precisa significar "padrões", não "usuário sem configuração".
model StockSettings {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// Falso bloqueia saída maior que o saldo, tanto nas operações manuais
  /// quanto na baixa automática da venda. Com a trava ligada, faltar insumo
  /// impede fechar a conta: a transação volta atrás e o pagamento não é
  /// confirmado. É uma decisão de operação — quem ainda está ajustando o
  /// estoque costuma preferir `true`, deixando o saldo negativo como sinal de
  /// conferência pendente em vez de travar o caixa.
  allowNegativeStock Boolean @default(false) @map("allow_negative_stock")

  /// Falso impede concluir a venda de um prato sem ficha ativa. Verdadeiro
  /// deixa vender, avisa, e não gera consumo — o estoque desse prato passa a
  /// não ser confiável, e é por isso que a resposta devolve o alerta.
  allowSaleWithoutRecipe Boolean @default(true) @map("allow_sale_without_recipe")

  /// Margem, em porcento, entre o consumo previsto pelas fichas e o que saiu de
  /// fato do estoque. Dentro dela o desvio é ruído de operação — porção servida
  /// a olho, arredondamento de balança — e não vale investigação. Existe para
  /// que o relatório aponte poucos insumos de verdade em vez de listar todos.
  stockConsumptionTolerancePercentage Decimal @default(5) @map("stock_consumption_tolerance_percentage") @db.Decimal(7, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stock_settings")
}

// ===========================================================================
// Compras, fornecedores e histórico de custo
// ===========================================================================

model Supplier {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  name     String
  document String?
  phone    String?
  email    String?
  notes    String?
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases      Purchase[]
  suppliesAsLast Supply[]            @relation("SupplyLastSupplier")
  costHistory    SupplyCostHistory[]

  @@unique([userId, name])
  @@index([userId])
  @@map("suppliers")
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  CANCELED

  @@map("purchase_status")
}

/// Nota de compra. Nasce DRAFT e não encosta no estoque; ao ser confirmada,
/// cada item gera uma movimentação PURCHASE e atualiza o custo do insumo —
/// tudo na mesma transação.
model Purchase {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  supplierId String? @map("supplier_id") @db.Uuid

  documentNumber String?  @map("document_number")
  issuedAt       DateTime @map("issued_at")
  notes          String?

  /// Soma dos itens, calculada — nunca informada pelo cliente. Frete e
  /// desconto ainda não são modelados; quando forem, entram como linhas
  /// próprias e este campo continua sendo a soma.
  totalAmount Decimal @default(0) @map("total_amount") @db.Decimal(14, 2)

  status      PurchaseStatus @default(DRAFT)
  confirmedAt DateTime?      @map("confirmed_at")
  canceledAt  DateTime?      @map("canceled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items    PurchaseItem[]

  @@index([userId, issuedAt])
  @@index([userId, status])
  @@map("purchases")
}

model PurchaseItem {
  id         String @id @default(uuid()) @db.Uuid
  purchaseId String @map("purchase_id") @db.Uuid
  supplyId   String @map("supply_id") @db.Uuid
  unitId     String @map("unit_id") @db.Uuid

  quantity     Decimal @db.Decimal(18, 6)
  quantityBase Decimal @map("quantity_base") @db.Decimal(18, 6)

  /// Preço por unidade comprada (R$/KG). Preservado para leitura humana.
  unitPrice  Decimal @map("unit_price") @db.Decimal(14, 6)
  totalPrice Decimal @map("total_price") @db.Decimal(14, 4)

  /// Preço por unidade base (R$/G) — totalPrice / quantityBase. É este que
  /// permite comparar compras feitas em unidades diferentes.
  unitCostBase Decimal @map("unit_cost_base") @db.Decimal(14, 6)

  batch     String?   @map("batch")
  expiresAt DateTime? @map("expires_at")

  /// Movimentação gerada na confirmação. Nulo enquanto a compra é rascunho.
  movementId String? @unique @map("movement_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  purchase Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supply   Supply          @relation(fields: [supplyId], references: [id])
  unit     MeasurementUnit @relation(fields: [unitId], references: [id])
  movement StockMovement?  @relation(fields: [movementId], references: [id])

  costHistory SupplyCostHistory?

  @@index([supplyId])
  @@index([purchaseId])
  @@map("purchase_items")
}

enum CostSource {
  PURCHASE
  MANUAL
  ADJUSTMENT

  @@map("cost_source")
}

/// Histórico de custo do insumo. Append-only: cada compra confirmada acrescenta
/// uma linha, e nenhuma anterior é sobrescrita. É o que sustenta o relatório de
/// variação de preço e, mais adiante, o custo da ficha técnica na data.
model SupplyCostHistory {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  supplyId String @map("supply_id") @db.Uuid

  /// Custo por unidade base. É o único campo comparável entre compras feitas
  /// em unidades diferentes — comparar R$/KG com R$/G daria variação errada.
  unitCostBase         Decimal  @map("unit_cost_base") @db.Decimal(14, 6)
  previousUnitCostBase Decimal? @map("previous_unit_cost_base") @db.Decimal(14, 6)

  /// Variação percentual contra o custo anterior, já calculada e congelada.
  /// Nula na primeira compra, quando não há contra o que comparar.
  variationPercent Decimal? @map("variation_percent") @db.Decimal(12, 4)

  /// Preço e unidade como foram comprados, para o relatório mostrar
  /// "R$ 35/kg" em vez de "R$ 0,035/g".
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 6)
  unitId    String  @map("unit_id") @db.Uuid

  source         CostSource @default(PURCHASE)
  purchaseItemId String?    @unique @map("purchase_item_id") @db.Uuid
  supplierId     String?    @map("supplier_id") @db.Uuid

  effectiveAt DateTime @map("effective_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  supply       Supply          @relation(fields: [supplyId], references: [id])
  unit         MeasurementUnit @relation(fields: [unitId], references: [id])
  purchaseItem PurchaseItem?   @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
  supplier     Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([userId, supplyId, effectiveAt])
  @@map("supply_cost_history")
}

// ===========================================================================
// Fichas técnicas
// ===========================================================================

/// Ficha técnica versionada.
///
/// Reaproveita `Product` como o prato — não existe entidade paralela para
/// representar prato. Um produto pode ter várias versões de ficha, e só uma
/// fica ativa para novas vendas. Versão antiga nunca é apagada: é ela que
/// explica o custo das vendas feitas enquanto valia.
///
/// `productId` nulo marca uma SUB-RECEITA (molho, massa base, pré-preparo),
/// que existe para ser usada dentro de outras fichas. Nesta fase a sub-receita
/// só compõe custo; transformá-la em estoque próprio depende de ordem de
/// produção, que ainda não existe.
model Recipe {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  productId String? @map("product_id") @db.Uuid

  /// Obrigatório quando `productId` é nulo — é o nome da sub-receita.
  name String?

  version Int
  active  Boolean @default(false)

  /// Quanto uma execução desta ficha rende. Para prato costuma ser 1 porção;
  /// para sub-receita é o volume produzido (2000 ML de molho, por exemplo).
  yieldQuantity Decimal @default(1) @map("yield_quantity") @db.Decimal(18, 6)
  yieldUnitId   String? @map("yield_unit_id") @db.Uuid

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
  yieldUnit   MeasurementUnit?   @relation("RecipeYieldUnit", fields: [yieldUnitId], references: [id])
  items       RecipeItem[]
  usedAsSubIn RecipeItem[]       @relation("RecipeSubRecipe")
  sizeFactors RecipeSizeFactor[]

  /// Snapshot da ficha usada em cada item de venda (preenchido na baixa).
  productOrders ProductOrder[]

  @@unique([userId, productId, version])
  @@index([userId, productId])
  @@index([userId, active])
  @@map("recipes")
}

/// Linha da ficha: um insumo OU uma sub-receita, nunca os dois.
model RecipeItem {
  id       String @id @default(uuid()) @db.Uuid
  recipeId String @map("recipe_id") @db.Uuid

  supplyId    String? @map("supply_id") @db.Uuid
  subRecipeId String? @map("sub_recipe_id") @db.Uuid

  /// Unidade em que a quantidade foi escrita na ficha. Para item de insumo,
  /// precisa ser da mesma grandeza da unidade base dele; para sub-receita, da
  /// mesma grandeza do rendimento dela.
  unitId String @map("unit_id") @db.Uuid

  quantity Decimal @db.Decimal(18, 6)

  /// Quantidade líquida convertida: para insumo, na unidade base dele; para
  /// sub-receita, na unidade de rendimento dela.
  quantityBase Decimal @map("quantity_base") @db.Decimal(18, 6)

  /// Perda de preparo, em porcento. Segue a convenção de ficha técnica:
  /// é quanto se perde do que entra, então a quantidade bruta necessária é
  /// `líquida / (1 - perda)`. Para 200 g líquidos com 10% de perda, é preciso
  /// partir de 222,22 g — e não de 220 g.
  wastePercent Decimal @default(0) @map("waste_percent") @db.Decimal(7, 4)

  notes     String?
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")

  recipe    Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  supply    Supply?         @relation(fields: [supplyId], references: [id])
  subRecipe Recipe?         @relation("RecipeSubRecipe", fields: [subRecipeId], references: [id])
  unit      MeasurementUnit @relation("RecipeItemUnit", fields: [unitId], references: [id])

  @@index([recipeId])
  @@index([supplyId])
  @@index([subRecipeId])
  @@map("recipe_items")
}

/// Multiplicador de consumo por tamanho.
///
/// A ficha descreve uma unidade do prato; o tamanho vendido escala o consumo.
/// Uma pizza broto não usa a mesma massa que uma gigante, e sem este fator a
/// baixa erraria sistematicamente em todo produto vendido em mais de um
/// tamanho. Tamanho sem fator cadastrado vale 1 — a ficha vale como está.
model RecipeSizeFactor {
  id       String @id @default(uuid()) @db.Uuid
  recipeId String @map("recipe_id") @db.Uuid

  size   SizeType
  factor Decimal  @db.Decimal(10, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, size])
  @@map("recipe_size_factors")
}

// ===========================================================================
// Despesas operacionais e rateio de custo indireto
// ===========================================================================

enum ExpenseType {
  /// Não varia com o volume vendido: aluguel, contador, internet.
  FIXED
  /// Acompanha o movimento: comissão, taxa de cartão, embalagem de entrega.
  VARIABLE

  @@map("expense_type")
}

/// Com que frequência a despesa se repete na competência.
enum ExpenseRecurrence {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY

  @@map("expense_recurrence")
}

/// Direto é o que a ficha técnica já mede (insumo consumido pelo prato);
/// indireto é o que precisa ser rateado. Só indireto entra no rateio — somar
/// um custo direto aqui o contaria duas vezes no custo completo.
enum CostNature {
  DIRECT
  INDIRECT

  @@map("cost_nature")
}

enum AllocationMethod {
  /// Total de despesas ÷ unidades vendidas. Único implementado nesta versão.
  PER_SOLD_UNIT
  BY_REVENUE
  MANUAL

  @@map("allocation_method")
}

/// Período de referência da estimativa de vendas.
enum AllocationPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY

  @@map("allocation_period")
}

model ExpenseCategory {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  name String

  /// Prepara a separação entre custo direto e indireto. Despesa operacional
  /// nasce INDIRECT; a categoria é onde isso passa a ser configurável quando
  /// houver custo direto que não venha de ficha técnica.
  nature CostNature @default(INDIRECT)

  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, name])
  @@index([userId])
  @@map("expense_categories")
}

/// Despesa do estabelecimento, descrita como REGRA e não como lançamento.
///
/// Um aluguel mensal é uma linha só: valor, início e periodicidade. As
/// ocorrências de cada mês são derivadas da regra na hora do relatório, o que
/// mantém a competência correta sem depender de alguém lançar todo mês.
///
/// Mudança de valor não edita a linha: encerra esta com `endDate` e cria outra.
/// Editar o valor reescreveria o custo de todos os meses anteriores — o mesmo
/// motivo de `unitPrice` existir congelado no item de venda.
model Expense {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  expenseCategoryId String? @map("expense_category_id") @db.Uuid

  description String
  type        ExpenseType       @default(FIXED)
  recurrence  ExpenseRecurrence @default(MONTHLY)

  amount Decimal @db.Decimal(14, 2)

  /// Competência, não data de cadastro: é a partir daqui que a despesa passa a
  /// pesar no custo, mesmo que tenha sido cadastrada meses depois. Guardadas
  /// como data pura para a competência não escorregar por fuso horário.
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  active Boolean @default(true)

  /// Quando a despesa deixou de valer, se ela foi desligada sem `endDate`.
  /// Sem este carimbo, desativar o aluguel hoje zeraria o custo de janeiro —
  /// desativar é parar de repetir daqui pra frente, não apagar o passado.
  deactivatedAt DateTime? @map("deactivated_at")

  /// Permite tirar uma despesa específica do rateio sem desativá-la nem mudar
  /// a categoria dela — investimento pontual, obra, compra de equipamento.
  includeInAllocation Boolean @default(true) @map("include_in_allocation")

  notes String?

  /// Exclusão lógica: relatórios de competência antiga continuam reproduzíveis.
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)

  @@index([userId, active])
  @@index([userId, startDate])
  @@index([expenseCategoryId])
  @@map("expenses")
}

/// Como o custo indireto vira custo por unidade vendida.
model CostAllocationSettings {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  method AllocationMethod @default(PER_SOLD_UNIT)

  /// A que período a estimativa se refere. Um relatório de três meses com
  /// referência MENSAL multiplica a estimativa por três, para que o custo por
  /// unidade não mude só porque a janela ficou maior.
  referencePeriod AllocationPeriod @default(MONTHLY) @map("reference_period")

  /// Unidades que se espera vender no período de referência. É o divisor do
  /// PER_SOLD_UNIT.
  estimatedSalesUnits Decimal @default(0) @map("estimated_sales_units") @db.Decimal(18, 6)

  /// Receita esperada no período de referência. Sem uso enquanto BY_REVENUE
  /// não estiver habilitado; fica aqui para o método nascer com dado.
  estimatedRevenue Decimal @default(0) @map("estimated_revenue") @db.Decimal(14, 2)

  /// Quais despesas entram no rateio, por tipo.
  includeFixed    Boolean @default(true) @map("include_fixed")
  includeVariable Boolean @default(true) @map("include_variable")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cost_allocation_settings")
}

// ===========================================================================
// Formação de preço
// ===========================================================================

/// Percentuais que entram na formação de preço.
///
/// Todos configuráveis: alíquota de imposto muda com o regime tributário, taxa
/// de cartão muda com a adquirente e margem é decisão de negócio. Fixar
/// qualquer um deles no código transformaria a conta num chute.
///
/// Registro ausente significa padrões, e o padrão de imposto e taxa é ZERO —
/// não dá para adivinhar o regime de ninguém, e um número inventado aqui sairia
/// como preço recomendado.
model PricingSettings {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// Margem desejada SOBRE O PREÇO DE VENDA, não sobre o custo. É o que a
  /// fórmula do divisor calcula: 30% aqui significa que 30% do preço final
  /// sobra como lucro, depois de custo, imposto e taxa.
  desiredMarginPercent Decimal @default(30) @map("desired_margin_percent") @db.Decimal(7, 4)

  taxPercent Decimal @default(0) @map("tax_percent") @db.Decimal(7, 4)

  /// Cartão e delivery raramente incidem na mesma venda. Somados, precificam
  /// o canal mais caro — que é o conservador quando existe um preço só para
  /// todos os canais. Cada endpoint aceita sobrescrever para simular outro.
  cardFeePercent     Decimal @default(0) @map("card_fee_percent") @db.Decimal(7, 4)
  deliveryFeePercent Decimal @default(0) @map("delivery_fee_percent") @db.Decimal(7, 4)
  otherFeesPercent   Decimal @default(0) @map("other_fees_percent") @db.Decimal(7, 4)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pricing_settings")
}
